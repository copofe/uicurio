---
// 全局骨架：<head>(SEO/hreflang/OG) + 移动顶栏 + 语言胶囊；页面自组 shell/侧栏
import "../styles/tokens.css";
import Wordmark from "../components/Wordmark.astro";
import type { Locale } from "../i18n";
interface Props { locale: Locale; title: string; description: string; ogImage?: string; hideTopbar?: boolean; }
const { locale, title, description, ogImage, hideTopbar = false } = Astro.props;
const url = Astro.url.pathname;
const other: Locale = locale === "en" ? "zh" : "en";
const swap = (loc: Locale) => url.replace(`/${locale}/`, `/${loc}/`);
const abs = (p: string) => new URL(p, Astro.site);
const enUrl = locale === "en" ? url : swap("en");
const effectiveOgImage = ogImage || "/assets/shots/dither-kit.webp";
const canonicalUrl = abs(url);
---
<!doctype html>
<html lang={locale}>
<head>
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("uicurio.theme");
        if (t !== "dark" && t !== "light") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = "light";
      }
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang={locale} href={abs(url)} />
  <link rel="alternate" hreflang={other} href={abs(swap(other))} />
  <link rel="alternate" hreflang="x-default" href={abs(enUrl)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Uicurio" />
  <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
  <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
  <meta property="og:image" content={abs(effectiveOgImage)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={abs(effectiveOgImage)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <slot name="head" />
  <!-- Cloudflare Web Analytics：控制台开启站点后，将本注释替换为带 token 的 beacon脚本 -->
</head>
<body>
  {!hideTopbar && (
    <header class="topbar">
      <button class="iconbtn menu-btn" type="button" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
      <a class="brand" href={`/${locale}/`} aria-label="Uicurio — home"><Wordmark /></a>
      <span class="topbar-space"></span>
      <button class="iconbtn search-btn" type="button" aria-label="Search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.5-4.5"></path></svg>
      </button>
    </header>
  )}

  <slot />
</body>
</html>
