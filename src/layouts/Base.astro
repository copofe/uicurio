---
import "../styles/tokens.css";
import type { Locale } from "../i18n";
interface Props { locale: Locale; title: string; description: string; ogImage?: string; }
const { locale, title, description, ogImage } = Astro.props;
const url = Astro.url.pathname;
const other: Locale = locale === "en" ? "zh" : "en";
const swap = (loc: Locale) => url.replace(`/${locale}/`, `/${loc}/`);
const abs = (p: string) => new URL(p, Astro.site);
const enUrl = locale === "en" ? url : swap("en");
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang={locale} href={abs(url)} />
  <link rel="alternate" hreflang={other} href={abs(swap(other))} />
  <link rel="alternate" hreflang="x-default" href={abs(enUrl)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {ogImage && <meta property="og:image" content={abs(ogImage)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Cloudflare Web Analytics：控制台开启站点后，将下面的注释换为带 token 的 beacon 脚本 -->
</head>
<body><slot /></body>
</html>

<style is:global>
/* ---- shared chrome ---- */
.site{display:grid;grid-template-columns:220px 1fr;min-height:100vh}
@media(max-width:1023px){.site{grid-template-columns:1fr}}
.side{border-right:1px solid var(--border);padding:24px 16px;position:sticky;top:0;height:100vh;overflow:auto}
@media(max-width:1023px){.side{position:static;height:auto;border-right:0;border-bottom:1px solid var(--border)}}
.side .logo{font-weight:600;font-size:15px;letter-spacing:-.02em}
.side .tagline{color:var(--text-2);font-size:13px;margin-top:2px}
.grp{margin-top:22px}
.grp h3{font-size:12px;color:var(--text-2);font-weight:400;margin-bottom:6px}
.navitem{display:flex;align-items:center;gap:8px;width:100%;text-align:left;padding:4px 8px;border-radius:6px;font-size:13px}
.navitem .n{margin-left:auto;color:var(--text-2);font-variant-numeric:tabular-nums}
.navitem[aria-current=page]{font-weight:600}
.navitem[aria-current=page]::before{content:"•"}
.navitem:not([aria-current=page])::before{content:"";width:7px}
label.check{display:flex;align-items:center;gap:8px;padding:3px 8px;font-size:13px;border-radius:6px;cursor:pointer}
label.check.off{opacity:.4;pointer-events:none}
label.check input{accent-color:var(--ink)}
label.check .n{margin-left:auto;color:var(--text-2);font-variant-numeric:tabular-nums}
.main{padding:28px 32px 80px}
@media(max-width:639px){.main{padding:20px 16px 60px}}
.toolbar{display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.toolbar h1{font-size:24px;font-weight:600;letter-spacing:-.02em}
.search{margin-left:auto;display:flex;align-items:center;gap:8px;border:1px solid var(--border);border-radius:8px;padding:5px 10px}
.search input{border:0;outline:0;font:inherit;font-size:13px;width:170px;background:none}
.count{font-size:13px;color:var(--text-2);font-variant-numeric:tabular-nums}
.grid{display:grid;gap:20px 12px;grid-template-columns:1fr}
@media(min-width:640px){.grid{grid-template-columns:1fr 1fr}}
@media(min-width:1280px){.grid{grid-template-columns:1fr 1fr 1fr}}
.card{border-radius:var(--radius-card);display:block;position:relative}
.cover{aspect-ratio:16/10;background:var(--surface-2);border-radius:var(--radius-card);overflow:hidden;position:relative}
.cover img{width:100%;height:100%;object-fit:cover;transition:transform .12s ease-out}
.card:hover .cover img{transform:scale(1.02)}
.jump{position:absolute;right:8px;bottom:8px;width:36px;height:36px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:15px}
.meta{padding:10px 2px}
.meta .t{font-size:14px;font-weight:600;display:flex;gap:6px;align-items:baseline}
.meta .t span{font-weight:400;color:var(--text-2);font-size:13px}
.meta .d{font-size:13px;color:var(--text-2);margin-top:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card.hidden{display:none}
.empty{color:var(--text-2);padding:32px 0;display:none}
.pill{font-size:12px;padding:2px 10px;border-radius:var(--radius-chip);background:var(--surface-2);color:var(--text-2)}
.btn{padding:7px 16px;border-radius:8px;font-size:14px;font-weight:500;display:inline-block}
.btn.pri{background:var(--ink);color:#fff}
.btn.ghost{border:1px solid var(--border)}
.crumbs{font-size:13px;color:var(--text-2);margin-bottom:18px}
.crumbs a:hover{text-decoration:underline}
.footer{color:var(--text-2);font-size:13px;margin-top:48px}
</style>
