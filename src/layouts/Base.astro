---
// 全局骨架：<head>(SEO/hreflang/OG) + 移动顶栏 + 语言胶囊；页面自组 shell/侧栏
import "../styles/tokens.css";
import type { Locale } from "../i18n";
interface Props { locale: Locale; title: string; description: string; ogImage?: string; }
const { locale, title, description, ogImage } = Astro.props;
const url = Astro.url.pathname;
const other: Locale = locale === "en" ? "zh" : "en";
const swap = (loc: Locale) => url.replace(`/${locale}/`, `/${loc}/`);
const abs = (p: string) => new URL(p, Astro.site);
const enUrl = locale === "en" ? url : swap("en");
---
<!doctype html>
<html lang={locale}>
<head>
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("uicurio.theme");
        if (t !== "dark" && t !== "light") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = "light";
      }
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang={locale} href={abs(url)} />
  <link rel="alternate" hreflang={other} href={abs(swap(other))} />
  <link rel="alternate" hreflang="x-default" href={abs(enUrl)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {ogImage && <meta property="og:image" content={abs(ogImage)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Cloudflare Web Analytics：控制台开启站点后，将本注释替换为带 token 的 beacon 脚本 -->
</head>
<body>
  <header class="topbar">
    <button class="iconbtn menu-btn" type="button" aria-label="Menu">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <a class="brand" href={`/${locale}/`} aria-label="uicurio — home"><svg class="wordmark play" viewBox="0 0 96 34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 15.5 C6 20, 7 24.5, 9.5 25.2 C11.5 25.7, 13.5 20.5, 14 15.5" pathLength="1" style="--i:0"></path><path d="M14 15.5 C14 20, 14.5 24, 16.5 24.8 C18.2 25.3, 19.6 23.4, 20.6 21.4" pathLength="1" style="--i:1"></path><path d="M24.5 16.5 C24 20, 24 23.5, 24.7 25.5" pathLength="1" style="--i:2"></path><path d="M26.6 10.6 L26.9 10.3" pathLength="1" style="--i:3"></path><path d="M38.5 15.8 C34 14.5, 30.5 17.5, 30.3 21 C30.1 24.5, 33.5 26.8, 38.5 25.6" pathLength="1" style="--i:4"></path><path d="M43.5 15.5 C43 20, 44 24.5, 46.5 25.2 C48.5 25.7, 50.5 20.5, 51 15.5" pathLength="1" style="--i:5"></path><path d="M51 15.5 C51 20, 51.5 24, 53.5 24.8 C55.3 25.4, 57.5 23, 58.6 20.4" pathLength="1" style="--i:6"></path><path d="M63 26.5 C62.5 22, 62.3 18, 62.8 14.8" pathLength="1" style="--i:7"></path><path d="M62.8 18.5 C64.5 16.6, 67.6 16.1, 69.4 17.2" pathLength="1" style="--i:8"></path><path d="M74 16.5 C73.6 20, 73.6 23.5, 74.3 25.5" pathLength="1" style="--i:9"></path><path d="M76.1 10.6 L76.4 10.3" pathLength="1" style="--i:10"></path><path d="M86.2 15.7 C83 15.4, 80 17.7, 80 20.8 C80 24.1, 82.9 26.3, 85.8 25.7 C88.8 25.1, 90.4 22.4, 89.9 19.7 C89.4 17.1, 87.1 15.6, 84.9 16.3" pathLength="1" style="--i:11"></path></svg></a>
    <span class="topbar-space"></span>
    <button class="iconbtn search-btn" type="button" aria-label="Search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.5-4.5"></path></svg>
    </button>
  </header>

  <slot />
</body>
</html>
