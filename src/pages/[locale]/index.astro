---
// 首页 = 全部藏品画廊（频道=全部，分面/搜索/排序全交互）
import GalleryShell from "../../components/GalleryShell.astro";
import { ui, LOCALES } from "../../i18n";
import { items } from "../../lib/data";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params;
const t = ui[locale as keyof typeof ui];
---
<GalleryShell locale={locale} currentCat={null} title="Uicurio" description={t.homeIntro} items={items} />
