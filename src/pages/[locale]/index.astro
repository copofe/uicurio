---
// 首页 = 全部藏品画廊（v2 index 形态：频道=全部，分面/搜索/排序全交互）
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import Directory from "../../components/Directory.astro";
import { ui, LOCALES } from "../../i18n";
import { categories, items, tags } from "../../lib/data";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params;
const t = ui[locale as keyof typeof ui];
const catsWithCount = categories.map((c: any) => ({ ...c, count: items.filter((i: any) => i.category === c.slug).length }));
const title = `uicurio — ${t.tagline}`;
---
<Base locale={locale as any} title={title} description={t.homeIntro}>
  <div class="shell">
    <Sidebar locale={locale} currentCat={null} showFacets={true} channelItems={items} tags={tags} total={items.length} categories={catsWithCount} />
    <Directory locale={locale} items={items} total={items.length} catSlug={null} categories={catsWithCount} tags={tags} />
  </div>
</Base>
