---
// 首页 = 全部藏品画廊（频道=全部，分面/搜索/排序全交互）
import GalleryShell from "../../components/GalleryShell.astro";
import { ui, LOCALES } from "../../i18n";
import { items } from "../../lib/data";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params;
const t = ui[locale as keyof typeof ui];
const title = locale === "zh"
  ? "Uicurio — 精选高质感开源 UI 库与动效组件"
  : "Uicurio — Hand-picked UI Libraries & Design Engineering Gems";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Uicurio",
  "url": `https://uicurio.shinji.me/${locale}/`,
  "description": t.homeIntro,
  "inLanguage": locale === "zh" ? "zh-CN" : "en-US"
};
---
<GalleryShell locale={locale} currentCat={null} title={title} description={t.homeIntro} items={items}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</GalleryShell>
