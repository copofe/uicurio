---
// 标签着陆页（≥2 条才生成，票 08 门槛）：面包屑 + 标题 + 静态网格（零 JS 的 SEO 页）
import Base from "../../../layouts/Base.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Payload from "../../../components/Payload.astro";
import CardV2 from "../../../components/CardV2.astro";
import { ui, LOCALES } from "../../../i18n";
import { items, tags, itemsWithTag, TAG_MIN } from "../../../lib/data";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    tags
      .filter((tg: any) => itemsWithTag(tg.id).length >= TAG_MIN)
      .map((tg: any) => ({ params: { locale, slug: tg.slug }, props: { tag: tg } }))
  );
}
const { locale, slug } = Astro.params;
const tag = Astro.props.tag as any;
const t = ui[locale as keyof typeof ui];
const list = itemsWithTag(tag.id);
const title = locale === "zh"
  ? `${tag.name.zh} 开源 UI 组件库 · 精选 ${list.length} 个项目 — Uicurio`
  : `${tag.name.en} Open Source UI Libraries & Components (${list.length} Curated) · Uicurio`;
const description = locale === "zh"
  ? `手工严选收录的 ${list.length} 个 ${tag.name.zh} 相关开源 UI 库、交互组件与设计工程实践，支持完整组件清单预览与代码检索。`
  : `Curated collection of ${list.length} open source UI libraries and design engineering components for ${tag.name.en}. Explore component lists, live previews and code repos.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Uicurio",
      "item": `https://uicurio.shinji.me/${locale}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": tag.name[locale] ?? tag.name.en,
      "item": `https://uicurio.shinji.me/${locale}/tags/${tag.slug}/`
    }
  ]
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": `https://uicurio.shinji.me/${locale}/tags/${tag.slug}/`,
  "inLanguage": locale === "zh" ? "zh-CN" : "en-US",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": list.length,
    "itemListElement": list.slice(0, 24).map((item: any, idx: number) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": item.name[locale] ?? item.name.en,
      "url": `https://uicurio.shinji.me/${locale}/item/${item.slug}/`,
      "image": `https://uicurio.shinji.me/assets/shots/${item.screenshot}`
    }))
  }
};
---
<Base locale={locale as any} title={title} description={description} ogImage={`/assets/shots/${list[0]?.screenshot}`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <div class="shell">
    <Sidebar locale={locale} showFacets={false} total={items.length} categories={[]} />
    <main class="main">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>Uicurio</a>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{tag.name[locale]}</span>
      </nav>
      <h1 style="font-size:28px;font-weight:600;letter-spacing:-.015em;margin:18px 0 4px">{tag.name[locale]}</h1>
      <p style="color:var(--text-2)">{description}</p>
      <div class="grid">{list.map((i: any, idx: number) => <CardV2 item={i} locale={locale} index={idx} />)}</div>
    </main>
  </div>
  <Payload locale={locale} page="info" />
</Base>
