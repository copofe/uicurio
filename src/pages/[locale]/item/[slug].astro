---
// 条目详情（与弹窗完全统一的 Dribbble 全屏剧场形态）
import Base from "../../../layouts/Base.astro";
import Payload from "../../../components/Payload.astro";
import Wordmark from "../../../components/Wordmark.astro";
import { ui, LOCALES } from "../../../i18n";
import { items, categories, tagById } from "../../../lib/data";
import { esc, pickRelated, renderItemContent, type ItemView } from "../../../lib/item-view";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => items.map((item: any) => ({ params: { locale, slug: item.slug }, props: { item } })));
}
const { locale, slug } = Astro.params;
const item = Astro.props.item as any;
const t = ui[locale as keyof typeof ui];
const description = item.description[locale] ?? item.description.en;

// 收录序（added 倒序 = 画廊默认序）→ 前后翻页
const byAdded = items;
const idx = byAdded.findIndex((x: any) => x.slug === item.slug);
const prevItem = idx > 0 ? byAdded[idx - 1] : null;
const nextItem = idx >= 0 && idx < byAdded.length - 1 ? byAdded[idx + 1] : null;

// 条目内容区：与弹窗共用 item-view.ts 单一渲染源（结构性消除双份漂移）
const toView = (x: any): ItemView => {
  const c = categories.find((cc: any) => cc.slug === x.category);
  return {
    slug: x.slug,
    name: x.name[locale] ?? x.name.en,
    desc: x.description[locale] ?? x.description.en,
    url: x.url,
    repo: x.repo || null,
    shot: x.screenshot,
    content: x.content?.[locale] ?? x.content?.en ?? "",
    components: x.components ?? [],
    catName: c ? c.name[locale] ?? c.name.en : x.category,
    catHref: `/${locale}/collections/${x.category}/`,
    tags: (x.tags ?? []).map((id: string) => {
      const tg = tagById.get(id);
      return {
        id,
        name: tg ? tg.name[locale] ?? tg.name.en : id,
        href: tg ? `/${locale}/tags/${tg.slug}/` : `/${locale}/`,
      };
    }),
  };
};
const view = toView(item);
const related = pickRelated(items.map(toView), view);
const name = view.name;

// 页面自有的翻页器（弹窗的是动态版，见 island.js buildSheetPager）；经 bodySuffix 注入 .sheet-body 末尾
const pagerSvgPrev = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>';
const pagerSvgNext = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
const bodySuffix = `<nav class="sheet-pager" aria-label="Prev / Next">${
  prevItem
    ? `<a class="sheet-pager-btn sheet-pager-prev" href="/${locale}/item/${prevItem.slug}/">${pagerSvgPrev}<span>${t.pagerPrev || "Previous"}: ${esc(prevItem.name[locale] ?? prevItem.name.en)}</span></a>`
    : `<button class="sheet-pager-btn" disabled type="button">${pagerSvgPrev}<span>${t.pagerPrev || "Previous"}</span></button>`
}${
  nextItem
    ? `<a class="sheet-pager-btn sheet-pager-next" href="/${locale}/item/${nextItem.slug}/"><span>${esc(nextItem.name[locale] ?? nextItem.name.en)} · ${t.pagerNext || "Next"}</span>${pagerSvgNext}</a>`
    : `<button class="sheet-pager-btn" disabled type="button"><span>${t.pagerNext || "Next"}</span>${pagerSvgNext}</button>`
}</nav>`;
const itemContentHtml = renderItemContent(view, related, locale, bodySuffix);
const title = `${name} · Uicurio`;
---
<Base locale={locale as any} title={title} description={description} ogImage={`/assets/shots/${item.screenshot}`} hideTopbar={true}>
  <!-- 浮动左右导航箭头 (Dribbble 标志性悬浮边缘控件，屏幕 > 1360px 时显示) -->
  {prevItem && (
    <a class="sheet-float-nav sheet-float-prev" href={`/${locale}/item/${prevItem.slug}/`} aria-label={`${t.pagerPrev || "Previous"}: ${prevItem.name[locale] ?? prevItem.name.en}`} title={`${t.pagerPrev || "Previous"}: ${prevItem.name[locale] ?? prevItem.name.en}`}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </a>
  )}
  {nextItem && (
    <a class="sheet-float-nav sheet-float-next" href={`/${locale}/item/${nextItem.slug}/`} aria-label={`${nextItem.name[locale] ?? nextItem.name.en} · ${t.pagerNext || "Next"}`} title={`${nextItem.name[locale] ?? nextItem.name.en} · ${t.pagerNext || "Next"}`}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </a>
  )}

  <div class="sheet-page">
    <!-- 1. 页面导航栏（仅保留功能性控件；条目信息由署名行承载，与弹窗一致） -->
    <header class="sheet-head">
      <div class="sheet-head-left">
        <a class="brand" href={`/${locale}/`} aria-label="Uicurio — home">
          <Wordmark />
        </a>
      </div>
      <div class="sheet-nav">
        <select class="langsel" data-lang-select aria-label="Language">
          <option value="en" selected={locale === "en"}>English</option>
          <option value="zh" selected={locale === "zh"}>中文</option>
        </select>
        <button type="button" class="iconbtn" data-theme-toggle aria-label={t.theme}>
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        </button>
        <a class="iconbtn sheet-close-btn" href={`/${locale}/`} onclick="if (history.length > 1 && document.referrer.includes(location.host)) { history.back(); return false; }" aria-label={t.close || "Back"} title={t.close || "Back"}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </a>
      </div>
    </header>

    <!-- 2–4. 条目内容区：与弹窗共享 item-view.ts 单一渲染源（署名行→封面→正文→同柜推荐→翻页器） -->
    <Fragment set:html={itemContentHtml} />

    <!-- 5. 底部品牌与偏好控制条 -->
    <footer class="sheet-footer">
      <div class="sheet-footer-left">
        <a href={`/${locale}/`} class="sheet-footer-brand">Uicurio</a>
        <span class="sheet-footer-sep">·</span>
        <span>{locale === "zh" ? "官方精选收录" : "Curated UI Collection"}</span>
      </div>
      <div class="sheet-footer-right">
        <select class="langsel" data-lang-select aria-label="Language">
          <option value="en" selected={locale === "en"}>English</option>
          <option value="zh" selected={locale === "zh"}>中文</option>
        </select>
        <button type="button" class="iconbtn" data-theme-toggle aria-label={t.theme}>
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        </button>
      </div>
    </footer>
  </div>
  <Payload locale={locale} page="info" channel={item.category} />
</Base>
