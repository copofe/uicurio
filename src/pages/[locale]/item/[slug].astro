---
// 条目详情（v2 item 形态）：面包屑 + 封面 + 标题/描述/CTA/元信息/标签 + 同柜推荐 + 前后翻页
import Base from "../../../layouts/Base.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Payload from "../../../components/Payload.astro";
import CardV2 from "../../../components/CardV2.astro";
import { ui, LOCALES } from "../../../i18n";
import { items, categories, tagById } from "../../../lib/data";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => items.map((item: any) => ({ params: { locale, slug: item.slug }, props: { item } })));
}
const { locale, slug } = Astro.params;
const item = Astro.props.item as any;
const t = ui[locale as keyof typeof ui];
const cat = categories.find((c: any) => c.slug === item.category);
const name = item.name[locale] ?? item.name.en;
const description = item.description[locale] ?? item.description.en;

// 收录序（added 倒序 = 画廊默认序）→ 前后翻页
const byAdded = [...items].sort((a: any, b: any) => (a.added < b.added ? 1 : a.added > b.added ? -1 : 0));
const idx = byAdded.findIndex((x: any) => x.slug === item.slug);
const older = byAdded[idx + 1];
const newer = byAdded[idx - 1];

// 同柜推荐：同频道优先，不足 3 补同标签（v2 规则）
const alts = items.filter((x: any) => x.slug !== item.slug && x.category === item.category);
if (alts.length < 3) {
  for (const x of items) {
    if (alts.length >= 3) break;
    if (x.slug === item.slug || alts.includes(x)) continue;
    if (x.tags.some((tg: string) => item.tags.includes(tg))) alts.push(x);
  }
}
const title = `${name} · uicurio`;
---
<Base locale={locale as any} title={title} description={description} ogImage={`/assets/shots/${item.screenshot}`}>
  <div class="shell">
    <Sidebar locale={locale} currentCat={item.category} showFacets={false} total={items.length} categories={categories.map((c: any) => ({ ...c, count: items.filter((i: any) => i.category === c.slug).length }))} />
    <main class="main">
      <div class="item-wrap">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href={`/${locale}/`}>uicurio</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href={`/${locale}/collections/${cat.slug}/`}>{cat.name[locale]}</a>
          <span class="sep" aria-hidden="true">/</span>
          <span aria-current="page">{name}</span>
        </nav>

        <div class="item-cover"><img src={`/assets/shots/${item.screenshot}`} alt={name} width="1600" height="1000" /></div>

        <header class="item-head">
          <h1>{name}</h1>
          <p class="item-desc">{description}</p>
          <div class="item-cta">
            <a class="btn btn-solid" href={item.url} target="_blank" rel="noopener">{t.visitSite}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </a>
            {item.repo && <a class="btn btn-ghost" href={item.repo} target="_blank" rel="noopener">{t.source}</a>}
          </div>
          <p class="item-meta">
            <span>{t.added} {item.added}</span>
            <a href={`/${locale}/collections/${cat.slug}/`}>{cat.name[locale]}</a>
          </p>
          <div class="tagrow">
            {item.tags.map((id: string) => {
              const tag = tagById.get(id);
              if (!tag) return null;
              const n = items.filter((x: any) => x.tags.includes(id)).length;
              return n >= 2
                ? <a class="chip chip-tag" href={`/${locale}/tags/${tag.slug}/`}><span class="t">{tag.name[locale]}</span><span class="n">{n}</span></a>
                : <span class="chip"><span class="t">{tag.name[locale]}</span></span>;
            })}
          </div>
        </header>

        {alts.length > 0 && (
          <section class="sect">
            <h2>{t.altTitle}</h2>
            <p class="sect-sub">{t.altSub}</p>
            <div class="grid">{alts.slice(0, 3).map((x: any, i: number) => <CardV2 item={x} locale={locale} index={i} />)}</div>
          </section>
        )}

        <nav class="pager" aria-label="Prev / Next">
          {older ? (
            <a href={`/${locale}/item/${older.slug}/`}>
              <span class="dir">{t.pagerOlder}</span>
              <span class="pname">{older.name[locale] ?? older.name.en}</span>
            </a>
          ) : <span></span>}
          {newer && (
            <a class="next" href={`/${locale}/item/${newer.slug}/`}>
              <span class="dir">{t.pagerNewer}</span>
              <span class="pname">{newer.name[locale] ?? newer.name.en}</span>
            </a>
          )}
        </nav>
      </div>
    </main>
  </div>
  <Payload locale={locale} page="info" channel={item.category} />
</Base>
