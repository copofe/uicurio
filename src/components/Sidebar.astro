---
// v2 画廊壳：字标 + 频道导航 + 分面 chips 的侧栏，主列由调用方（Directory）填充
import { ui } from "../i18n";
import { categoriesWithCount, items, tags } from "../lib/data";
interface Props {
  locale: string;
  currentCat?: string | null;
  showFacets?: boolean;
  channelItems?: any[];
}
const { locale, currentCat = null, showFacets = false, channelItems = [] } = Astro.props;
const t = ui[locale as keyof typeof ui];
const FACETS = ["function", "stack", "style", "scenario"] as const;
const countIn = (id: string) => channelItems.filter((i: any) => i.tags.includes(id)).length;
---
<aside class="sidebar">
  <div class="side-scroll">
    <a class="brand" href={`/${locale}/`} aria-label="Uicurio — home">
      <svg class="wordmark play" viewBox="0.2 -80.7 231.9 86.6" fill="currentColor" aria-hidden="true"><g transform="translate(0.00, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:0" d="M221 -29Q174 -29 145 7Q132 23 126.5 45Q121 67 121 94Q121 163 162 258Q32 267 32 401Q32 478 75 565Q91 597 110 625.5Q129 654 151 676Q207 735 268 735Q380 735 380 604Q380 534 335 448Q313 405 288 363.5Q263 322 238 280Q281 288 332 308Q335 309 338 309Q346 309 346 302Q346 295 336 291Q306 280 279 272Q252 264 228 260Q176 161 176 87Q176 46 190 20Q207 -10 240 -10Q296 -10 368 69Q416 121 459 189Q502 257 542 342Q547 352 551 360.5Q555 369 559 376Q591 441 619.5 502.5Q648 564 684 618Q791 777 884 777Q913 777 935 762Q959 746 959 710Q959 685 946 669Q929 649 902 649Q880 649 868 663Q855 676 855 694Q855 742 902 742Q925 742 939 722Q938 742 921 752Q903 764 882 764Q807 764 727 618Q695 559 666.5 485.5Q638 412 612 324Q590 245 578 186.5Q566 128 566 91Q566 6 605 6Q633 6 672 56Q710 104 762 212Q766 222 772 224L773 224Q777 224 777 217Q777 209 773 201Q718 89 705 70Q650 -16 595 -16Q560 -16 534 10Q497 46 497 124Q497 171 512 232Q446 117 379 51Q296 -29 221 -29ZM171 276Q191 317 212 358.5Q233 400 254 441Q304 540 319 603Q325 629 325 650Q325 715 273 715Q237 715 191 671Q167 647 146 616Q125 585 108 546Q73 464 73 398Q73 287 171 276Z"/></g><g transform="translate(68.90, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:1" d="M191 387Q157 387 157 420Q157 453 189 453Q223 453 223 420Q223 387 191 387ZM55 0Q26 0 26 29Q26 47 38 78Q64 142 87 196Q110 250 130 294Q133 299 133 305Q133 319 120 335L175 336Q203 336 203 322Q203 318 201 313.5Q199 309 196 301L104 88Q90 55 90 32Q90 8 105 0Z"/></g><g transform="translate(86.10, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:2" d="M137 -4Q37 -4 37 96Q37 180 95 262Q158 352 240 352Q316 352 308 283Q307 265 289 244Q272 224 256 224Q247 224 241 230Q266 255 272 281Q274 288 275 293.5Q276 299 276 304Q276 330 252 330Q217 330 154 245Q94 164 94 87Q94 14 150 14Q204 14 255 82L261 90L275 82L268 72Q215 -4 137 -4Z"/></g><g transform="translate(113.10, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:3" d="M98 1Q34 1 34 61Q34 82 46 117.5Q58 153 80 202L135 323Q144 344 174 344L234 344Q199 318 170 260Q159 238 143.5 205.5Q128 173 108 131Q89 92 89 61Q89 29 111 29Q135 29 168 67Q223 131 316 323Q327 344 354 344L408 344Q375 317 339 245Q289 144 279 91Q278 85 277.5 80Q277 75 277 70Q277 31 304 31Q333 31 372 88L387 81Q333 1 280 1Q224 1 224 72Q224 99 234 129Q160 1 98 1Z"/></g><g transform="translate(150.50, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:4" d="M10 -7Q29 41 60.5 113Q92 185 132 277Q140 297 147.5 309Q155 321 161 328Q174 343 196 340L217 337Q224 336 229.5 335.5Q235 335 239 336Q219 326 192.5 279.5Q166 233 134 153Q145 167 162 190.5Q179 214 205 245Q234 279 265 308Q296 337 325 337Q348 337 358 322Q368 307 368 288Q368 265 350 247Q332 229 315 229Q308 229 300.5 232Q293 235 293 241Q293 246 295 250.5Q297 255 297 261Q297 276 283 276Q278 276 269.5 273.5Q261 271 247 257Q219 231 186.5 194.5Q154 158 125.5 113Q97 68 79 14Q74 -1 49 -2Q15 -4 10 -7Z"/></g><g transform="translate(180.00, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:5" d="M191 387Q157 387 157 420Q157 453 189 453Q223 453 223 420Q223 387 191 387ZM55 0Q26 0 26 29Q26 47 38 78Q64 142 87 196Q110 250 130 294Q133 299 133 305Q133 319 120 335L175 336Q203 336 203 322Q203 318 201 313.5Q199 309 196 301L104 88Q90 55 90 32Q90 8 105 0Z"/></g><g transform="translate(197.20, 0) scale(0.100000, -0.100000)"><path pathLength="1" style="--i:6" d="M110 0Q37 0 37 89Q37 133 58 182Q88 253 143 302Q197 350 245 350Q319 350 319 263Q319 218 297 168Q271 108 222 59Q161 0 110 0ZM126 22Q149 22 175 41Q208 65 250 141Q296 223 296 273Q296 318 258 318Q228 318 190 280Q153 243 127 186Q92 111 92 66Q92 22 126 22Z"/></g></svg>
    </a>
    <div class="side-block">
      <p class="side-label">{t.channels}</p>
      <nav class="navlist" aria-label={t.channels}>
        <a class="navrow" href={`/${locale}/`} aria-current={currentCat === null ? "page" : undefined}>
          <i class="dot" aria-hidden="true"></i><span>{t.all}</span><span class="count">{items.length}</span>
        </a>
        {categoriesWithCount.map((c: any) => (
          <a class="navrow" href={`/${locale}/collections/${c.slug}/`} aria-current={currentCat === c.slug ? "page" : undefined}>
            <i class="dot" aria-hidden="true"></i><span>{c.name[locale]}</span><span class="count">{c.count}</span>
          </a>
        ))}
      </nav>
    </div>
    {showFacets && (
      <div class="side-tag-filter-wrap">
        <div class="side-tag-search">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.5-4.5"/></svg>
          <input type="search" placeholder={t.filterTagsPh} data-tag-filter aria-label={t.filterTagsPh} />
        </div>
      </div>
    )}
    {showFacets && (FACETS as readonly string[]).map((facet) => {
      const facetTags = tags.filter((x: any) => x.facet === facet).sort((a: any, b: any) => countIn(b.id) - countIn(a.id));
      const INITIAL_LIMIT = 6;
      const initialTags = facetTags.slice(0, INITIAL_LIMIT);
      const moreTags = facetTags.slice(INITIAL_LIMIT);
      return (
        <div class="facet-group" data-facet={facet}>
          <button type="button" class="facet-head" data-facet-toggle={facet} aria-expanded="true">
            <span class="side-label">{t[facet as "function" | "stack" | "style" | "scenario"]}</span>
            <span class="facet-active-badge" data-facet-badge={facet} hidden>0</span>
            <svg class="facet-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="chiprow">
            {initialTags.map((x: any) => (
              <button type="button" class="chip" data-tag={x.id} aria-pressed="false">
                <span class="t">{x.name[locale]}</span>
                <span class="n">{countIn(x.id)}</span>
              </button>
            ))}
            {moreTags.length > 0 && (
              <div class="chiprow-overflow" hidden>
                {moreTags.map((x: any) => (
                  <button type="button" class="chip" data-tag={x.id} aria-pressed="false">
                    <span class="t">{x.name[locale]}</span>
                    <span class="n">{countIn(x.id)}</span>
                  </button>
                ))}
              </div>
            )}
            {moreTags.length > 0 && (
              <button type="button" class="chip chip-more" data-more-toggle data-more-count={moreTags.length}>
                <span class="t">+{moreTags.length} {t.showMoreTags}</span>
              </button>
            )}
          </div>
        </div>
      );
    })}
  </div>
  <div class="side-foot">
    <select class="langsel" data-lang-select aria-label="Language">
      <option value="en" selected={locale === "en"}>English</option>
      <option value="zh" selected={locale === "zh"}>中文</option>
    </select>
    <button type="button" class="iconbtn" data-theme-toggle aria-label={t.theme}>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
    </button>
  </div>
</aside>
