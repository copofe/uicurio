---
// v2 画廊壳：字标 + 频道导航 + 分面 chips 的侧栏，主列由调用方（Directory）填充
import { ui } from "../i18n";
import Wordmark from "./Wordmark.astro";
import { categoriesWithCount, items, tags } from "../lib/data";
interface Props {
  locale: string;
  currentCat?: string | null;
  showFacets?: boolean;
  channelItems?: any[];
}
const { locale, currentCat = null, showFacets = false, channelItems = [] } = Astro.props;
const t = ui[locale as keyof typeof ui];
const FACETS = ["function", "stack", "style", "scenario"] as const;
const countIn = (id: string) => channelItems.filter((i: any) => i.tags.includes(id)).length;
---
<aside class="sidebar">
  <div class="side-scroll">
    <a class="brand" href={`/${locale}/`} aria-label="Uicurio — home">
      <Wordmark />
    </a>
    <div class="side-block">
      <p class="side-label">{t.channels}</p>
      <nav class="navlist" aria-label={t.channels}>
        <a class="navrow" href={`/${locale}/`} aria-current={currentCat === null ? "page" : undefined}>
          <i class="dot" aria-hidden="true"></i><span>{t.all}</span><span class="count">{items.length}</span>
        </a>
        {categoriesWithCount.map((c: any) => (
          <a class="navrow" href={`/${locale}/collections/${c.slug}/`} aria-current={currentCat === c.slug ? "page" : undefined}>
            <i class="dot" aria-hidden="true"></i><span>{c.name[locale]}</span><span class="count">{c.count}</span>
          </a>
        ))}
      </nav>
    </div>
    {showFacets && (
      <div class="side-tag-filter-wrap">
        <div class="side-tag-search">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.5-4.5"/></svg>
          <input type="search" placeholder={t.filterTagsPh} data-tag-filter aria-label={t.filterTagsPh} />
        </div>
      </div>
    )}
    {showFacets && (FACETS as readonly string[]).map((facet) => {
      const facetTags = tags.filter((x: any) => x.facet === facet).sort((a: any, b: any) => countIn(b.id) - countIn(a.id));
      const INITIAL_LIMIT = 6;
      const initialTags = facetTags.slice(0, INITIAL_LIMIT);
      const moreTags = facetTags.slice(INITIAL_LIMIT);
      return (
        <div class="facet-group" data-facet={facet}>
          <button type="button" class="facet-head" data-facet-toggle={facet} aria-expanded="true">
            <span class="side-label">{t[facet as "function" | "stack" | "style" | "scenario"]}</span>
            <span class="facet-active-badge" data-facet-badge={facet} hidden>0</span>
            <svg class="facet-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="chiprow">
            {initialTags.map((x: any) => (
              <button type="button" class="chip" data-tag={x.id} aria-pressed="false">
                <span class="t">{x.name[locale]}</span>
                <span class="n">{countIn(x.id)}</span>
              </button>
            ))}
            {moreTags.length > 0 && (
              <div class="chiprow-overflow" hidden>
                {moreTags.map((x: any) => (
                  <button type="button" class="chip" data-tag={x.id} aria-pressed="false">
                    <span class="t">{x.name[locale]}</span>
                    <span class="n">{countIn(x.id)}</span>
                  </button>
                ))}
              </div>
            )}
            {moreTags.length > 0 && (
              <button type="button" class="chip chip-more" data-more-toggle data-more-count={moreTags.length}>
                <span class="t">+{moreTags.length} {t.showMoreTags}</span>
              </button>
            )}
          </div>
        </div>
      );
    })}
  </div>
  <div class="side-foot">
    <select class="langsel" data-lang-select aria-label="Language">
      <option value="en" selected={locale === "en"}>English</option>
      <option value="zh" selected={locale === "zh"}>中文</option>
    </select>
    <button type="button" class="iconbtn" data-theme-toggle aria-label={t.theme}>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
    </button>
  </div>
</aside>
