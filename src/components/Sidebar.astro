2Q15 465 9.5 481Q4 497 8 518Q14 548 29 577Q45 605 64 620Q64 620 64 620Q69 623 74 625.5Q79 628 83 628Q86 627 87 625Q88 623 88 621Q88 618 89 616Q90 614 92 613Q98 612 103 614Z"/></g><g transform="translate(0.00, 82) scale(0.048828, -0.048828)"><path pathLength="1" style="--i:3" d="M60 632L60 632Q61 636 61 640Q60 646 56.5 649.5Q53 653 47 656Q46 657 42.5 658Q39 659 36 660Q33 661 31 660Q29 659 23.5 649.5Q18 640 13 630Q8 620 6 617Q-11 582 -18 546Q-25 498 17 479Q50 470 78 488Q106 506 126 531Q120 488 131.5 445Q143 402 193 396Q238 398 280.5 426Q323 454 373 506Q405 543 411.5 547.5Q418 552 421 559Q421 563 416.5 563.5Q412 564 410 560Q372 505 312 454Q252 403 192 399Q164 403 157 431Q150 459 151 483Q152 504 155 525Q155 526 155 526Q157 537 159.5 548.5Q162 560 166 570Q170 580 171.5 586.5Q173 593 172 599Q171 604 166.5 609.5Q162 615 156 618Q150 621 146 618Q141 615 137.5 601.5Q134 588 131.5 572.5Q129 557 128 549Q128 548 128 547Q111 525 82 501.5Q53 478 24 486Q12 490 10 504Q8 518 13 537Q16 547 19 557Q24 572 30.5 587.5Q37 603 47 615Q51 620 54 623.5Q57 627 60 632Z"/></g><g transform="translate(0.00, 82) scale(0.048828, -0.048828)"><path pathLength="1" style="--i:4" d="M370 566Q369 565 363 552Q342 509 296 443.5Q250 378 199.5 324Q149 270 117 270Q108 275 106.5 300Q105 325 112 386Q119 447 111.5 482Q104 517 61 530Q50 532 40 534Q30 535 21 537Q16 538 15 543.5Q14 549 16.5 559Q19 569 23 579.5Q27 590 30 599Q33 608 32 613Q31 618 17.5 622Q4 626 2 623Q-3 613 -6 603Q-7 599 -8 595Q-11 580 -12.5 564Q-14 548 -8 540Q-4 536 6.5 532.5Q17 529 23 528Q75 519 83.5 492.5Q92 466 86 427.5Q80 389 79 356Q78 323 85.5 295.5Q93 268 117 266Q152 269 202.5 321Q253 373 297.5 436Q342 499 367 549Q370 551 372 554.5Q374 558 374 560Q374 566 370 566Z"/></g><g transform="translate(0.00, 82) scale(0.048828, -0.048828)"><path pathLength="1" style="--i:5" d="M39 621L39 621Q42 629 37 639Q31 644 19 644Q7 644 4 636Q-10 583 -16 529Q-21 487 -9.5 447.5Q2 408 51 402Q102 403 147.5 444.5Q193 486 233 547Q242 555 242 559Q242 563 240 562Q237 559 231 548Q198 496 151 451Q104 406 50 406Q27 407 19 430.5Q11 454 12 487Q13 514 17 541Q19 552 21.5 564Q24 576 39 621ZM58 671L58 671Q59 672 60 673Q63 676 65 679Q68 683 70.5 690Q73 697 72 703Q72 704 71 706.5Q70 709 67.5 712.5Q65 716 60.5 717.5Q56 719 53 720Q53 720 53 720Q47 721 44 720Q41 719 38 713Q34 706 32 697Q30 688 33 681Q42 667 58 671Z"/></g><g transform="translate(0.00, 82) scale(0.048828, -0.048828)"><path pathLength="1" style="--i:6" d="M51 658L51 658Q48 656 43.5 652.5Q39 649 36 646Q11 621 -3 584.5Q-17 548 -25 514Q-33 484 -31 453Q-29 422 4 409Q17 405 31 413Q48 422 63 446Q81 474 92.5 517.5Q104 561 89 590Q94 587 99 584Q114 575 134 567Q173 553 218.5 548Q264 543 298 552Q323 556 323 561Q321 564 305 558Q263 545 209 551.5Q155 558 117 576Q100 585 85 595Q84 596 83 596Q83 595 83 594.5Q83 594 84 594Q91 585 93 574Q95 563 94 552Q93 527 83 498.5Q73 470 60 449Q45 425 28 416Q17 409 6 412Q-5 416 -7 432Q-9 448 -6.5 465.5Q-4 483 -2 491Q10 549 41 599Q42 601 47 605Q81 629 77 636Q74 644 70 648Q65 654 60 656.5Q55 659 51 658Z"/></g></svg>
      <span class="brand-sub">{t.tagline}</span>
    </a>
  <div class="side-scroll">
    <div class="side-block">
      <p class="side-label">{t.channels}</p>
      <nav class="navlist" aria-label={t.channels}>
        <a class="navrow" href={`/${locale}/`} aria-current={currentCat === null ? "page" : undefined}>
          <i class="dot" aria-hidden="true"></i><span>{t.all}</span><span class="count">{total}</span>
        </a>
        {categories.map((c: any) => (
          <a class="navrow" href={`/${locale}/collections/${c.slug}/`} aria-current={currentCat === c.slug ? "page" : undefined}>
            <i class="dot" aria-hidden="true"></i><span>{c.name[locale]}</span><span class="count">{c.count}</span>
          </a>
        ))}
      </nav>
    </div>
    {showFacets && (FACETS as readonly string[]).map((facet) => (
      <div class="facet-group" data-facet={facet}>
        <p class="side-label">{t[facet as "function" | "stack" | "style" | "scenario"]}</p>
        <div class="chiprow">
          {tags.filter((x: any) => x.facet === facet).map((x: any) => (
            <button type="button" class="chip" data-tag={x.id} aria-pressed="false">
              <span class="t">{x.name[locale]}</span>
              <span class="n">{countIn(x.id)}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="side-foot">
    <select class="langsel" data-lang-select aria-label="Language">
      <option value="en" selected={locale === "en"}>English</option>
      <option value="zh" selected={locale === "zh"}>中文</option>
    </select>
    <button type="button" class="iconbtn" data-theme-toggle aria-label={t.theme}>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
    </button>
  </div>
</aside>
