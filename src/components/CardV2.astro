---
// v2 图文卡：article.card > media-wrap(整面进详情 + ↗ 独立外链) + 标题/频道 + 两行描述
import { categories } from "../lib/data";
interface Props { item: any; locale: string; index?: number; }
const { item, locale, index = 0 } = Astro.props;
const cat = categories.find((c: any) => c.slug === item.category);
const name = item.name[locale] ?? item.name.en;
const desc = item.description[locale] ?? item.description.en;
const text = `${item.name.en} ${item.name.zh} ${item.description.en} ${item.description.zh}`.toLowerCase();
---
<article class="card" data-slug={item.slug} style={`--stagger:${index % 9}`}>
  <div class="media-wrap">
    <a class="card-link enter" href={`/${locale}/item/${item.slug}/`} aria-label={`${name} · 详情`}>
      <div class="card-media">
        <div class="cover"><img src={`/assets/shots/${item.screenshot}`} alt={name} loading="lazy" decoding="async" width="1600" height="1000" /></div>
      </div>
    </a>
    <a class="go" href={item.url} target="_blank" rel="noopener" aria-label={`Visit ${name}`}>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
    </a>
  </div>
  <h3 class="card-title">
    <a class="card-titlelink" href={`/${locale}/item/${item.slug}/`}>{name}</a>
    <span class="cat">{cat?.name[locale] ?? ""}</span>
  </h3>
  <p class="card-desc">{desc}</p>
</article>
