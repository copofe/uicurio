# 0. 全局默认规则（针对 HTML 及页面文档：每次部署即时更新，不缓存在浏览器）
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# 1. Astro 构建带哈希的静态资源（JS/CSS/模块，内容变哈希变，永久强缓存 1 年）
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# 2. 静态通用资源文件夹（浏览器存 7 天，Cloudflare 边缘 CDN 存 30 天）
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400

# 3. 藏品封面大图（文件名固定，浏览器存 30 天，Cloudflare 边缘 CDN 存 1 年，7 天 stale-while-revalidate）
/assets/shots/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=604800

# 4. 根目录公共图片与图标（og.png, favicon.svg 等，浏览器存 7 天，CDN 存 30 天）
/og.png
  ! Cache-Control
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400

# 5. XML Sitemap 与爬虫规范（浏览器存 1 小时，CDN 存 1 天，保证爬虫即时获取最新条目）
/sitemap*.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600
